[{
    "layer": "bottom",
    "position": "top",
    "height": 18,
    "modules-left": [
        "custom/org-clock"
    ],
    "custom/org-clock": {
        "exec": "/home/mking/dotfiles/.config/waybar/scripts/org-clock.sh",
        "interval": 10,
        "format": "⏱ {}"
    },
    "modules-center": [
    "clock"
    ],
    "modules-right": [
        "network",
        "battery",
        "tray"
    ],
    "tray": {
        "spacing": 3
    },
    "clock": {
        "format": "{:%R}"
    },
    "network": {
        "format-wifi": "{ipaddr} {icon}",
        "format-ethernet": "{ipaddr}  ",
        "format-disconnected": "",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤢",
            "󰤨"
        ]
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    }
},
{
    "layer": "bottom",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "height": 18,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "pulseaudio"
    ],
    "mpris": {
      "format": "{player_icon} {dynamic}",
      "format-paused": "{status_icon} {dynamic}",
      "player-icons": {
        "default": "󰐊"
        // "firefox": "",
        // "chromium": ""
      },
      "status-icons": {
        "paused": "󰏤"
      },
      "dynamic-order": ["title", "artist"],
      "max-length": 100
    },
    "cpu": {
        "interval": 5,
        "format": "cpu {usage}%",
        "max-length": 10,
        "states": {
            "good": 0,
            "warning": 50,
            "critical": 80
        }
    },
    "memory": {
        "interval": 10,
        "format": "mem {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "RAM - {used:0.1f}GiB used"
    },
    "pulseaudio": {
        "max-volume": 150,
        "scroll-step": 10,
        "format": "vol {volume}%",
        "tooltip-format": "{volume}%",
        "on-click": "pwvucontrol"
    }
}
]
